        <http_method>GET</http_method>
        <name>Open Incident Count</name>
        <operation_script><![CDATA[(function process(request, response) {
    var userId = request.pathParams.user_id;

    // Validate that the user exists
    var user = new GlideRecord('sys_user');
    if (!user.get(userId)) {
        response.setStatus(404);
        return { error: 'User not found', user_id: userId };
    }

    var util = new TriageUtils();
    return {
        user_id: userId,
        user_name: user.getValue('user_name'),
        open_incidents: util.getOpenIncidentCount(userId)
    };
})(request, response);]]></operation_script>
